<Solution>
  <Configurations>
    <BuildType Name="Debug" />
    <BuildType Name="Release" />
    <BuildType Name="Release-NotWindows" />
  </Configurations>
  <Folder Name="/Solution Items/">
    <File Path="../claude.md" />
    <File Path="../readme.md" />
    <File Path="../.github/workflows/build.yml" />
    <File Path="../.github/workflows/build-native.yml" />
    <File Path="../.github/workflows/sample-native.yml" />
    <File Path="../cmake/PlatformHeads.cmake" />
    <File Path="../native/build-linux.sh" />
    <File Path="Directory.Build.props" />
    <File Path="Directory.Packages.props" />
    <File Path="../global.json" />
  </Folder>
  <Project Path="PlatformHeads/PlatformHeads.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="PlatformHeads.Core/PlatformHeads.Core.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="PlatformHeads.WindowsForms/PlatformHeads.WindowsForms.csproj">
    <!-- Builds everywhere, as the heads that reference it do. It only runs on Windows. -->
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="PlatformHeads.Tests/PlatformHeads.Tests.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
  </Project>
  <Project Path="PlatformHeads.WindowsForms.Tests/PlatformHeads.WindowsForms.Tests.csproj">
    <BuildType Solution="Release-NotWindows|*" Project="Release" />
    <!-- Targets net10.0-windows and opens real windows, so it neither builds nor runs off Windows. -->
    <Build Solution="Release-NotWindows|*" Project="false" />
  </Project>
</Solution>
